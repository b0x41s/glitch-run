+def test_biomes_registration_and_signed_score(client):
+    h = register(client)
+    assert any(g['id'] == 'biomes' for g in client.get('/v1/games').json())
+    assert play(client, h, 100, game='biomes', character='timed-none-diorama').status_code == 200
+    assert client.get('/v1/games/biomes/leaderboard').json()['entries'][0]['score'] == 100
+
+
+def test_personal_calendar_periods(client):
+    import psycopg
+    h = register(client)
+    assert play(client, h, 100).status_code == 200
+    with psycopg.connect(settings.DATABASE_URL, autocommit=True) as conn:
+        conn.execute("UPDATE runs SET finished_at = now() - interval '40 days'")
+    assert client.get('/v1/me/scores?period=all', headers=h).json()[0]['best'] == 100
+    assert client.get('/v1/me/scores?period=week', headers=h).json() == []
+    assert client.get('/v1/me/scores?period=month', headers=h).json() == []
+    assert client.get('/v1/me/scores?period=year', headers=h).status_code == 422
+
+
+def test_pending_and_concurrent_runs_keep_their_original_identity(client):
+    h = register(client)
+    first = client.post('/v1/games/biomes/runs', json={'character': 'timed-none-diorama'}, headers=h).json()
+    second = client.post('/v1/games/biomes/runs', json={'character': 'sprint-none-diorama'}, headers=h).json()
+    for run in (first, second):
+        body = {'score': 100, 'proof': proof(run['secret'], run['run_id'], 100)}
+        assert client.post(f"/v1/runs/{run['run_id']}/finish", json=body, headers=h).status_code == 200
+    rows = client.get('/v1/me/scores?game=biomes', headers=h).json()
+    assert len(rows) == 2 and sum(r['runs'] for r in rows) == 2
